# Copie para backend/.env e ajuste. Caminhos relativos partem da raiz do repositório.

# Banco SQLite local (fora do git).
DATABASE_PATH=data/gastos.db

# Backups automáticos antes de cada importação (spec §7.5).
BACKUPS_DIR=backups
BACKUPS_KEEP=10

# Gemini (R11): desligado por padrão.
GEMINI_ENABLED=false
GEMINI_API_KEY=
