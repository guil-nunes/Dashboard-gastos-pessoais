# Copie para backend/.env e ajuste. Caminhos relativos partem da raiz do repositório.

# Banco SQLite local (fora do git).
DATABASE_PATH=data/gastos.db

# Backups automáticos antes de cada importação (spec §7.5).
BACKUPS_DIR=backups
BACKUPS_KEEP=10

# Detector de recorrência (R9): ocorrências mínimas, intervalo em dias e tolerância sobre a mediana.
RECURRENCE_MIN_OCCURRENCES=3
RECURRENCE_MIN_DAYS=25
RECURRENCE_MAX_DAYS=35
RECURRENCE_TOLERANCE_PCT=10

# Gemini (R11): desligado por padrão.
GEMINI_ENABLED=false
GEMINI_API_KEY=
